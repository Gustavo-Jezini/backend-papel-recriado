{
  "name": "backend-papel-recriado-finances",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "typeorm:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "typeorm:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "typeorm:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "typeorm:show": "npm run typeorm -- migration:show -d src/data-source.ts"
  },
  "author": "gustavo-jezini",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "1.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.4.2"
  }
}
